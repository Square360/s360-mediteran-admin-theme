{
    "name": "square360/s360_mediteran",
    "description": "Square360 Mediteran",
    "type": "drupal-theme",
    "homepage": "https://bitbucket.org/sq360_sysadmin/s360-mediteran-admin-theme",
    "keywords": [
        "Drupal",
        "Theme",
        "Admin Theme"
    ],
    "license": "GPL-2.0-or-later",
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "composer",
            "url": "https://packages.square360.com"
        }
    ],
    "require": {
        "drupal/admin_toolbar": "^3.4",
        "drupal/admin_toolbar_mediteran": "^1.17",
        "drupal/mediteran": "^1.30"
    },
    "require-dev": {
        "drupal/coder": "^8.3",
        "squizlabs/php_codesniffer": "3.*",
        "dealerdirect/phpcodesniffer-composer-installer": "^0.7.1"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
